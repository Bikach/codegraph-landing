---
import '../styles/global.css';
import { url } from '../utils/paths';
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Reduce LLM API costs by 40% with code knowledge graphs" />
    <meta name="theme-color" content="#f3f2f2" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>CodeGraph - Give Claude a Map of Your Codebase</title>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <main class="w-full max-w-[100vw] overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
