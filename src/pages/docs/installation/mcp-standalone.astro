---
import DocsLayout from '../../../layouts/Docs.astro';
import CodeBlock from '../../../components/docs/CodeBlock.astro';
import Callout from '../../../components/docs/Callout.astro';
import PrevNext from '../../../components/docs/PrevNext.astro';

const mcpConfig = `{
  "mcpServers": {
    "codegraph": {
      "command": "node",
      "args": ["/absolute/path/to/codegraph/mcp-server/dist/index.js"],
      "env": {
        "EMBEDDED_DB_PATH": "/path/to/graph.lbug"
      }
    }
  }
}`;
---

<DocsLayout title="Installation - MCP Standalone">
  <article class="prose max-w-none">
    <h1 class="text-4xl font-bold text-text-primary mb-4">MCP Standalone Installation</h1>

    <p class="text-xl text-text-secondary mb-8">
      Run CodeGraph as a standalone MCP server for use with any MCP-compatible client.
    </p>

    <Callout type="info" title="When to use MCP Standalone?">
      Choose this option if you:
      <ul class="mt-2 space-y-1">
        <li>Want to use CodeGraph with Claude Desktop or other MCP clients</li>
        <li>Need access to all 10 MCP tools (including get_god_nodes and get_module_overview)</li>
        <li>Prefer manual control over indexing and configuration</li>
      </ul>
    </Callout>

    <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Prerequisites</h2>

    <div class="space-y-4 mb-8">
      <div class="flex items-start gap-4 glass-card p-4">
        <div class="flex-shrink-0 w-10 h-10 bg-secondary/20 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
          </svg>
        </div>
        <div>
          <h3 class="text-text-primary font-semibold">Node.js >= 18</h3>
          <p class="text-text-secondary text-sm mt-1">
            Required for building and running the MCP server.
            <a href="https://nodejs.org/" class="text-primary hover:text-secondary">Install Node.js</a>
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4 glass-card p-4">
        <div class="flex-shrink-0 w-10 h-10 bg-primary/20 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
          </svg>
        </div>
        <div>
          <h3 class="text-text-primary font-semibold">Embedded graph (bundled)</h3>
          <p class="text-text-secondary text-sm mt-1">
            The graph is an embedded, in-process database (LadybugDB) - a single on-disk file.
            No server, no Docker, nothing to install separately.
          </p>
        </div>
      </div>
    </div>

    <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Quick Start</h2>

    <h3 class="text-xl font-semibold text-text-primary mt-8 mb-3">Step 1: Clone the Repository</h3>

    <CodeBlock
      code={`git clone https://github.com/Bikach/codeGraph.git
cd codeGraph`}
      lang="bash"
      title="Terminal"
    />

    <h3 class="text-xl font-semibold text-text-primary mt-8 mb-3">Step 2: Build the MCP Server</h3>

    <CodeBlock
      code={`cd mcp-server
npm install
npm run build`}
      lang="bash"
      title="Terminal"
    />

    <h3 class="text-xl font-semibold text-text-primary mt-8 mb-3">Step 3: Index Your Project</h3>

    <p class="text-text-secondary mb-4">
      Run the indexing script to analyze your codebase. Point <code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">EMBEDDED_DB_PATH</code> at
      the graph file to create (or update):
    </p>

    <CodeBlock
      code="EMBEDDED_DB_PATH=/path/to/graph.lbug npx tsx src/scripts/index-project.ts /path/to/project"
      lang="bash"
      title="Terminal"
    />

    <h3 class="text-xl font-semibold text-text-primary mt-8 mb-3">Step 4: Configure Your MCP Client</h3>

    <p class="text-text-secondary mb-4">
      Add CodeGraph to your MCP client configuration. For Claude Desktop, edit <code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">claude_desktop_config.json</code>.
      For Claude Code, edit <code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">.mcp.json</code> (project) or <code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">~/.claude/claude.json</code> (global):
    </p>

    <CodeBlock
      code={mcpConfig}
      lang="json"
      title=".mcp.json"
    />

    <Callout type="tip" title="One shared file">
      Point <code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">EMBEDDED_DB_PATH</code> at the same file used during indexing.
      The indexer and the MCP server share one on-disk graph file; the server reads it on each query, so re-indexing does not require a restart.
    </Callout>

    <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Indexing Options</h2>

    <p class="text-text-secondary mb-4">
      The indexing script supports several options:
    </p>

    <div class="overflow-x-auto mb-6">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 px-4 text-text-primary font-semibold">Option</th>
            <th class="py-3 px-4 text-text-primary font-semibold">Description</th>
          </tr>
        </thead>
        <tbody class="text-text-secondary">
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">--exclude-tests</code></td>
            <td class="py-3 px-4">Exclude test files (<code>*Test.kt</code>, <code>*Spec.kt</code>, <code>/test/</code>, <code>/tests/</code>).</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">--dry-run</code></td>
            <td class="py-3 px-4">Parse and resolve only, skip the graph write. Useful for validation.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-text-secondary mb-4">Examples:</p>

    <CodeBlock
      code={`# Index a project into the graph file (re-indexing replaces this project's data, idempotently)
EMBEDDED_DB_PATH=/path/to/graph.lbug npx tsx src/scripts/index-project.ts /path/to/project

# Index excluding test files
EMBEDDED_DB_PATH=/path/to/graph.lbug npx tsx src/scripts/index-project.ts --exclude-tests /path/to/project

# Validate parsing without writing to the graph
EMBEDDED_DB_PATH=/path/to/graph.lbug npx tsx src/scripts/index-project.ts --dry-run /path/to/project`}
      lang="bash"
      title="Terminal"
    />

    <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Available Tools</h2>

    <p class="text-text-secondary mb-4">
      In MCP Standalone mode, you have access to all <strong class="text-text-primary">10 MCP tools</strong>:
    </p>

    <div class="overflow-x-auto mb-6">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 px-4 text-text-primary font-semibold">Tool</th>
            <th class="py-3 px-4 text-text-primary font-semibold">Description</th>
          </tr>
        </thead>
        <tbody class="text-text-secondary">
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">search_nodes</code></td>
            <td class="py-3 px-4">Search classes, interfaces, functions by name or pattern</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_callers</code></td>
            <td class="py-3 px-4">Find all functions calling a specified function</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_callees</code></td>
            <td class="py-3 px-4">Find all functions called by a specified function</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_neighbors</code></td>
            <td class="py-3 px-4">Get dependencies and dependents of a class/interface</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_implementations</code></td>
            <td class="py-3 px-4">Find implementations of an interface</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_impact</code></td>
            <td class="py-3 px-4">Analyze impact of modifying a node</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">find_path</code></td>
            <td class="py-3 px-4">Find shortest path between two nodes</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_file_symbols</code></td>
            <td class="py-3 px-4">List all symbols defined in a file</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_god_nodes</code></td>
            <td class="py-3 px-4">Find the highest-degree nodes (system hotspots)</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 px-4"><code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">get_module_overview</code></td>
            <td class="py-3 px-4">Project map: domains, cross-domain dependencies, cycles</td>
          </tr>
        </tbody>
      </table>
    </div>

    <Callout type="tip" title="Portable graph file">
      The entire graph lives in the single file at <code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">EMBEDDED_DB_PATH</code>.
      Delete it to start fresh, back it up, or move it between machines - there is no server or volume to manage.
    </Callout>
  </article>

  <PrevNext
    prev={{ title: "Claude Plugin", href: "/docs/installation/claude-plugin" }}
    next={{ title: "/codegraph:init", href: "/docs/commands/init" }}
  />
</DocsLayout>
