---
import DocsLayout from '../../../layouts/Docs.astro';
import CodeBlock from '../../../components/docs/CodeBlock.astro';
import Callout from '../../../components/docs/Callout.astro';
import PrevNext from '../../../components/docs/PrevNext.astro';
import { url } from '../../../utils/paths';
---

<DocsLayout title="/codegraph:index">
  <h1 class="text-4xl font-bold text-text-primary mb-4">/codegraph:index</h1>
  <p class="text-xl text-text-secondary mb-8">
    Indexes your codebase into the embedded graph.
  </p>

  <Callout type="warning" title="Run /codegraph:init first">
    Indexing needs the plugin's native dependencies. If you have not installed them yet, run
    <a href={url('/docs/commands/init')} class="text-primary hover:text-secondary underline">/codegraph:init</a>
    once and reconnect codegraph from <code class="bg-bg-subtle px-2 py-0.5 rounded text-primary">/mcp</code> before indexing.
  </Callout>

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Overview</h2>
  <p class="text-text-secondary mb-4">
    The <code class="bg-bg-subtle px-2 py-1 rounded text-primary">/codegraph:index</code> command scans your source files and builds a comprehensive graph representation of your codebase in an embedded, on-disk graph file. This enables powerful code analysis, navigation, and impact analysis features.
  </p>

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">What it does</h2>
  <ul class="list-disc list-inside text-text-secondary space-y-2 mb-6">
    <li>Scans source files in your project directory</li>
    <li>Extracts classes, interfaces, functions, and properties</li>
    <li>Identifies relationships: inheritance, implementation, calls, uses</li>
    <li>Stores all nodes and relationships in the embedded graph file</li>
    <li>Creates indexes for fast querying</li>
  </ul>

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Usage</h2>
  <p class="text-text-secondary mb-4">
    Invoke the command in your Claude Code session:
  </p>

  <CodeBlock
    code="/codegraph:index"
    lang="bash"
    title="Claude Code"
  />

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Options</h2>
  <p class="text-text-secondary mb-4">
    The index command supports several options:
  </p>

  <div class="overflow-x-auto mb-6">
    <table class="w-full text-sm text-left text-text-secondary">
      <thead class="text-xs uppercase bg-bg-subtle text-text-muted">
        <tr>
          <th class="px-4 py-3 rounded-tl-lg">Option</th>
          <th class="px-4 py-3 rounded-tr-lg">Description</th>
        </tr>
      </thead>
      <tbody class="bg-bg-subtle">
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-text-primary"><code class="text-primary">path</code></td>
          <td class="px-4 py-3">Path to project directory (defaults to current working directory)</td>
        </tr>
        <tr>
          <td class="px-4 py-3 font-medium text-text-primary"><code class="text-primary">--exclude-tests</code></td>
          <td class="px-4 py-3">Exclude test files (<code class="text-primary">*Test.kt</code>, <code class="text-primary">*Spec.kt</code>, <code class="text-primary">/test/</code>, <code class="text-primary">/tests/</code>)</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h3 class="text-xl font-semibold text-text-primary mt-8 mb-3">Examples</h3>

  <CodeBlock
    code={`/codegraph:index                      # Index current project
/codegraph:index /path/to/project     # Index specific project
/codegraph:index --exclude-tests      # Exclude test files`}
    lang="bash"
    title="Claude Code"
  />

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Example Output</h2>
  <CodeBlock
    code={`> /codegraph:index .

⏺ Bash(bash ".../codegraph/scripts/index-project.sh" /path/to/my-backend)
  ⎿  {
       "success": true,
       "projectPath": "/path/to/my-backend",
       "filesFound": 208,
       "filesParsed": 208,
       "parseErrors": 0,
       "symbolsResolved": 1050,
       "nodesCreated": 1863,
       "relationshipsCreated": 3282,
       "writeErrors": 0,
       "dryRun": false,
       "message": "Indexed 208 files. Created 1863 nodes and 3282 relationships."
     }`}
    lang="bash"
    title="Claude Code"
    copyable={false}
  />

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Supported Languages</h2>
  <p class="text-text-secondary mb-4">
    CodeGraph currently supports indexing for the following languages:
  </p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="glass-card p-4">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">Kt</span>
        </div>
        <div>
          <h3 class="text-text-primary font-semibold">Kotlin</h3>
          <p class="text-text-secondary text-sm">Full support</p>
        </div>
      </div>
      <p class="text-text-secondary text-sm">Classes, objects, interfaces, functions, properties, extensions</p>
    </div>
    <div class="glass-card p-4">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 bg-attention rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">Jv</span>
        </div>
        <div>
          <h3 class="text-text-primary font-semibold">Java</h3>
          <p class="text-text-secondary text-sm">Full support</p>
        </div>
      </div>
      <p class="text-text-secondary text-sm">Classes, interfaces, methods, fields, annotations</p>
    </div>
    <div class="glass-card p-4">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 bg-secondary rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-sm">TS</span>
        </div>
        <div>
          <h3 class="text-text-primary font-semibold">TypeScript / JavaScript</h3>
          <p class="text-text-secondary text-sm">Full support</p>
        </div>
      </div>
      <p class="text-text-secondary text-sm">Classes, interfaces, functions, types, modules, decorators</p>
    </div>
  </div>

  <Callout type="info" title="More Languages Coming">
    Additional languages are planned for future releases.
  </Callout>

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Re-indexing Behavior</h2>
  <p class="text-text-secondary mb-4">
    When you run <code class="bg-bg-subtle px-2 py-1 rounded text-primary">/codegraph:index</code> on a project that has already been indexed:
  </p>

  <ul class="list-disc list-inside text-text-secondary space-y-2 mb-6">
    <li>The existing graph data for that project is cleared</li>
    <li>A fresh index is built from the current state of the codebase</li>
    <li>This ensures the graph accurately reflects your latest code changes</li>
  </ul>

  <Callout type="tip" title="When to Re-index">
    Re-index your project after significant code changes such as adding new modules, refactoring class hierarchies, or after pulling updates from your team.
  </Callout>

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Indexed Elements</h2>
  <p class="text-text-secondary mb-4">
    The indexer extracts the following node types:
  </p>

  <div class="overflow-x-auto mb-6">
    <table class="w-full text-sm text-left text-text-secondary">
      <thead class="text-xs uppercase bg-bg-subtle text-text-muted">
        <tr>
          <th class="px-4 py-3 rounded-tl-lg">Node Type</th>
          <th class="px-4 py-3">Description</th>
          <th class="px-4 py-3 rounded-tr-lg">Properties</th>
        </tr>
      </thead>
      <tbody class="bg-bg-subtle">
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-text-primary">Class</td>
          <td class="px-4 py-3">Classes and data classes</td>
          <td class="px-4 py-3"><code class="text-primary text-xs">name, visibility, file, line</code></td>
        </tr>
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-text-primary">Interface</td>
          <td class="px-4 py-3">Interfaces and protocols</td>
          <td class="px-4 py-3"><code class="text-primary text-xs">name, visibility, file, line</code></td>
        </tr>
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-text-primary">Function</td>
          <td class="px-4 py-3">Methods and standalone functions</td>
          <td class="px-4 py-3"><code class="text-primary text-xs">name, visibility, file, line, params</code></td>
        </tr>
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-text-primary">Property</td>
          <td class="px-4 py-3">Fields and properties</td>
          <td class="px-4 py-3"><code class="text-primary text-xs">name, visibility, file, line, type</code></td>
        </tr>
        <tr>
          <td class="px-4 py-3 font-medium text-text-primary">Object</td>
          <td class="px-4 py-3">Singleton objects (Kotlin)</td>
          <td class="px-4 py-3"><code class="text-primary text-xs">name, visibility, file, line</code></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Relationship Types</h2>
  <p class="text-text-secondary mb-4">
    The indexer identifies and stores these relationships:
  </p>

  <div class="overflow-x-auto mb-6">
    <table class="w-full text-sm text-left text-text-secondary">
      <thead class="text-xs uppercase bg-bg-subtle text-text-muted">
        <tr>
          <th class="px-4 py-3 rounded-tl-lg">Relationship</th>
          <th class="px-4 py-3 rounded-tr-lg">Description</th>
        </tr>
      </thead>
      <tbody class="bg-bg-subtle">
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-primary">EXTENDS</td>
          <td class="px-4 py-3">Class inheritance</td>
        </tr>
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-primary">IMPLEMENTS</td>
          <td class="px-4 py-3">Interface implementation</td>
        </tr>
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-primary">CALLS</td>
          <td class="px-4 py-3">Function/method invocations</td>
        </tr>
        <tr class="border-b border-border">
          <td class="px-4 py-3 font-medium text-primary">USES</td>
          <td class="px-4 py-3">Type dependencies and references</td>
        </tr>
        <tr>
          <td class="px-4 py-3 font-medium text-primary">DECLARES</td>
          <td class="px-4 py-3">A type declares its members (class/interface declares methods)</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 class="text-2xl font-semibold text-text-primary mt-10 mb-4">Next Steps</h2>
  <p class="text-text-secondary mb-4">
    After indexing, start exploring your code using the <a href={url('/docs/tools/search-nodes')} class="text-primary hover:text-secondary underline">query tools</a>.
  </p>

  <PrevNext
    prev={{ title: "/codegraph:init", href: "/docs/commands/init" }}
    next={{ title: "search_nodes", href: "/docs/tools/search-nodes" }}
  />
</DocsLayout>
